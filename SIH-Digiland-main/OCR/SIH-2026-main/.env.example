PROJECT_NAME="AI Land Record Digitization and Validation System"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-land-record-digitization-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite Local Default (or PostgreSQL override)
DATABASE_URL="sqlite+aiosqlite:///./land_records.db"

# Storage Folders
UPLOAD_DIR="./storage/uploads"
PROCESSED_DIR="./storage/processed"
EXPORT_DIR="./storage/exports"
FEEDBACK_DIR="./storage/feedback"

MAX_FILE_SIZE_MB=25
CONFIDENCE_THRESHOLD_HIGH=0.90
CONFIDENCE_THRESHOLD_MEDIUM=0.70
DEFAULT_OCR_LANGUAGE="en"
